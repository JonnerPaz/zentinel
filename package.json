{
  "name": "zentinel",
  "version": "1.6.0",
  "description": "Modular and simple TypeScript logging and monitoring library for Express applications",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc --noEmit && tsc -p tsconfig.build.json && node -e \"require('fs').cpSync('src/monitoring/dashboard.html', 'dist/monitoring/dashboard.html')\"",
    "dev": "tsx watch tests/LoggerTest.ts",
    "start": "tsx tests/LoggerTest.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "prepublishOnly": "pnpm test && pnpm build"
  },
  "keywords": [
    "logger",
    "logging",
    "monitoring",
    "metrics",
    "express",
    "middleware",
    "sqlite",
    "postgres"
  ],
  "author": "JonnerPaz",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JonnerPaz/Zentinel.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=18"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "11.10.0",
      "onFail": "download"
    }
  },
  "type": "module",
  "dependencies": {
    "better-sqlite3": "^13.0.3",
    "express": "^5.2.1",
    "pg": "^8.22.0",
    "typescript": "^7.0.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/better-sqlite3": "^9.6.0",
    "@types/express": "^5.0.6",
    "@types/node": "^26.1.2",
    "@types/pg": "^8.20.4",
    "tsx": "^4.23.1",
    "vitest": "^4.1.10"
  }
}
